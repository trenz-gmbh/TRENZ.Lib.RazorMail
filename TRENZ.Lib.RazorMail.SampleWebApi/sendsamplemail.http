# Via HTTPS and System.Net.Mail
POST http://localhost:5102/mail/SendWithSystemNet
Content-Type: application/json

{
  "from": "foo@example.com",
  "to": [
    "bar@example.com"
  ],
  "salutation": "Dear Bar"
}

###
# Via HTTP and MailKit and multiple recipients
POST http://localhost:5102/mail/SendWithMailKit
Content-Type: application/json

{
  "from": "foo@example.com",
  "to": [
    "bar@example.com",
    "qux@example.com"
  ],
  "salutation": "Dear Bar"
}

###
# Via ms graph
POST http://localhost:5102/mail/SendWithMSGraph
Content-Type: application/json

{
  "from": "from@someone.com",
  "to": [
    "to@someone.com"
  ],
  "salutation": "Dear To this is a test"
}
