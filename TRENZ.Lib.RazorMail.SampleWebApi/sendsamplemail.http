# Via HTTPS and System.Net.Mail
POST http://localhost:5102/mail/SendWithSystemNet
Content-Type: application/json

{
  "from": "foo@example.com",
  "to": ["bar@example.com"],
  "salutation": "Dear Bar"
}

###
# Via HTTP and MailKit and multiple recipients
POST http://localhost:5102/mail/SendWithMailKit
Content-Type: application/json

{
  "from": "foo@example.com",
  "to": ["bar@example.com", "qux@example.com"],
  "salutation": "Dear Bar"
}

###
# Via ms graph
POST http://localhost:5102/mail/SendWithMSGraph
Content-Type: application/json

{
  "from": "t.zimmer@trenz.de",
  "to": ["t.zimmer@trenz.de"],
  "salutation": "Dear Me this is a test one of many in fact o((⊙﹏⊙))o."
}
